#!/usr/bin/env bash
# texfi-extract here|folder ФАЙЛ... — распаковка zip/rar/7z/tar.* из контекстного меню Dolphin.
# Использует unrar, 7z и bsdtar (отдельный Ark не нужен). Зашифрованный архив: спрашивает пароль.
mode="$1"; shift
ok=0; fail=0

notify() { command -v notify-send >/dev/null && notify-send -a "Распаковка" "$1" "$2"; }

run_extract() { # $1 архив, $2 папка, $3 пароль (может быть пустым)
  local f="$1" dest="$2" pw="$3" lower
  lower="${f,,}"
  case "$lower" in
    *.rar)
      if command -v unrar >/dev/null; then
        unrar x -o+ -idq -p"${pw:--}" "$f" "$dest/" 2>&1 && return 0
      fi
      7z x -y -p"$pw" -o"$dest" "$f" 2>&1 ;;
    *.7z|*.zip)
      if [ -n "$pw" ]; then 7z x -y -p"$pw" -o"$dest" "$f" 2>&1; else
        7z x -y -p"" -o"$dest" "$f" </dev/null 2>&1; fi ;;
    *)
      bsdtar -xf "$f" -C "$dest" 2>&1 ;;
  esac
}

for f in "$@"; do
  [ -f "$f" ] || continue
  dir="$(dirname "$f")"; base="$(basename "$f")"
  name="${base%.*}"; name="${name%.tar}"
  if [ "$mode" = folder ]; then
    dest="$dir/$name"; n=1
    while [ -e "$dest" ]; do dest="$dir/$name ($n)"; n=$((n+1)); done
    mkdir -p "$dest"; made=1
  else
    dest="$dir"; made=0
  fi

  out="$(run_extract "$f" "$dest" "")"; rc=$?
  if [ $rc -ne 0 ] && echo "$out" | grep -qiE 'password|passphrase|encrypted|wrong|crypt'; then
    pw="$(kdialog --title "Распаковка" --password "Архив «$base» защищён паролем" 2>/dev/null)"
    if [ -n "$pw" ]; then out="$(run_extract "$f" "$dest" "$pw")"; rc=$?; fi
  fi

  if [ $rc -eq 0 ]; then
    ok=$((ok+1))
  else
    fail=$((fail+1))
    [ "$made" = 1 ] && rmdir "$dest" 2>/dev/null
    notify "Не удалось распаковать" "$base: $(echo "$out" | tail -1)"
  fi
done
[ $ok -gt 0 ] && notify "Готово" "Распаковано архивов: $ok"
[ $fail -eq 0 ]
